{
  "projectSettings": {
    "name": "Agricultural Web App",
    "description": "Django agricultural marketplace with serverless deployment"
  },
  "buildCommand": "cd backend && pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate",
  "outputDirectory": "backend",
  "installCommand": "pip install -r backend/requirements.txt",
  "env": {
    "DJANGO_SETTINGS_MODULE": "Agricultural.settings",
    "PYTHONPATH": "/var/task"
  },
  "build": {
    "env": {
      "PIP_CACHE_DIR": ".vercel_pip_cache",
      "PYTHON_RUNTIME": "python3.11"
    }
  },
  "functions": {
    "backend/wsgi.py": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/staticfiles/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/backend/wsgi.py"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/wsgi.py"
    }
  ]
}
